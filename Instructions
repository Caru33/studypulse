## 4. SCHÉMA DE BASE DE DONNÉES (Supabase / PostgreSQL)

```sql
-- Utilisateurs (géré par Supabase Auth, on étend avec profiles)
create table profiles (
  id uuid references auth.users primary key,
  email text not null,
  full_name text,
  university text,               -- "Université de Montréal", "HEC Montréal", etc.
  program text,                  -- "Pharmacie", "Administration", etc.
  plan text default 'free',      -- 'free' | 'pro'
  stripe_customer_id text,
  stripe_subscription_id text,
  created_at timestamptz default now()
);

-- Cours uploadés
create table courses (
  id uuid primary key default gen_random_uuid(),
  user_id uuid references profiles(id) on delete cascade,
  title text not null,
  description text,
  exam_date date,                -- date de l'examen pour planification
  file_url text,                 -- URL du PDF dans Supabase Storage
  content_text text,             -- texte extrait du PDF
  total_concepts integer default 0,
  mastery_score float default 0, -- 0.0 à 1.0 (score global de maîtrise)
  created_at timestamptz default now(),
  updated_at timestamptz default now()
);

-- Concepts/chapitres extraits d'un cours
create table concepts (
  id uuid primary key default gen_random_uuid(),
  course_id uuid references courses(id) on delete cascade,
  title text not null,
  content text not null,         -- texte brut du concept
  embedding vector(1536),        -- OpenAI text-embedding-3-small
  mastery_score float default 0, -- score de maîtrise spécifique à ce concept
  times_tested integer default 0,
  times_correct integer default 0,
  last_tested_at timestamptz,
  created_at timestamptz default now()
);

-- Sessions de quiz
create table quiz_sessions (
  id uuid primary key default gen_random_uuid(),
  user_id uuid references profiles(id) on delete cascade,
  course_id uuid references courses(id) on delete cascade,
  mode text not null,            -- 'adaptive' | 'review' | 'exam_prep'
  total_questions integer,
  correct_answers integer default 0,
  score float,                   -- 0.0 à 1.0
  duration_seconds integer,
  completed_at timestamptz,
  created_at timestamptz default now()
);

-- Questions individuelles d'un quiz
create table quiz_questions (
  id uuid primary key default gen_random_uuid(),
  session_id uuid references quiz_sessions(id) on delete cascade,
  concept_id uuid references concepts(id),
  question_text text not null,
  options jsonb not null,        -- ["option A", "option B", "option C", "option D"]
  correct_option integer not null, -- index 0-3
  user_answer integer,           -- index 0-3 (null si pas répondu)
  is_correct boolean,
  explanation text,              -- explication générée par GPT-4o
  created_at timestamptz default now()
);

-- Flashcards
create table flashcards (
  id uuid primary key default gen_random_uuid(),
  user_id uuid references profiles(id) on delete cascade,
  course_id uuid references courses(id) on delete cascade,
  concept_id uuid references concepts(id),
  front text not null,
  back text not null,
  -- Algorithme SM-2 (spaced repetition)
  ease_factor float default 2.5,
  interval_days integer default 1,
  repetitions integer default 0,
  next_review_date date default current_date,
  last_reviewed_at timestamptz,
  created_at timestamptz default now()
);

-- Plans d'étude générés
create table study_plans (
  id uuid primary key default gen_random_uuid(),
  user_id uuid references profiles(id) on delete cascade,
  generated_at timestamptz default now(),
  plan_data jsonb not null,      -- structure détaillée du plan
  is_active boolean default true
);

-- Activer l'extension pgvector pour les embeddings
create extension if not exists vector;

-- Row Level Security (chaque user voit seulement ses données)
alter table profiles enable row level security;
alter table courses enable row level security;
alter table concepts enable row level security;
alter table quiz_sessions enable row level security;
alter table quiz_questions enable row level security;
alter table flashcards enable row level security;
alter table study_plans enable row level security;

-- Policies RLS (exemple pour courses, reproduire pour toutes les tables)
create policy "Users can only access their own courses"
  on courses for all using (auth.uid() = user_id);
```

